<?xml version="1.0" encoding="UTF-8"?>
<!--
  Knowverse: 9 Ancient Megastructures. Pronunciation dictionary (alias rules).
  Alias rules replace the written word with a respelling before the model speaks it.
  ElevenLabs supports alias rules on all current TTS models, including eleven_v4.
  The approved script and the spoken-form copy keep the original spellings.
  These respellings are a first proposal. Test them in a cheap preview before full generation.
-->
<lexicon version="1.0"
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
  alphabet="ipa" xml:lang="en-GB">

  <!-- #9 Nan Madol -->
  <lexeme><grapheme>Pohnpei</grapheme><alias>Pone-pay</alias></lexeme>
  <lexeme><grapheme>Saudeleur</grapheme><alias>Sow-deh-lair</alias></lexeme>
  <lexeme><grapheme>Nan Madol</grapheme><alias>Nahn Mah-doll</alias></lexeme>

  <!-- #8 Stonehenge -->
  <lexeme><grapheme>Preseli</grapheme><alias>Preh-selly</alias></lexeme>

  <!-- #7 Rapa Nui -->
  <lexeme><grapheme>Moai</grapheme><alias>Moh-eye</alias></lexeme>
  <lexeme><grapheme>Rapa Nui</grapheme><alias>Rah-pah Noo-ee</alias></lexeme>
  <lexeme><grapheme>Rano Raraku</grapheme><alias>Rah-no Rah-rah-koo</alias></lexeme>
  <lexeme><grapheme>Lipo</grapheme><alias>Lee-poh</alias></lexeme>
  <lexeme><grapheme>Paro</grapheme><alias>Pah-roh</alias></lexeme>

  <!-- #6 Giza -->
  <lexeme><grapheme>Khufu</grapheme><alias>Koo-foo</alias></lexeme>
  <lexeme><grapheme>Wadi al-Jarf</grapheme><alias>Wah-dee al-Jarf</alias></lexeme>
  <lexeme><grapheme>Merer</grapheme><alias>Meh-rer</alias></lexeme>
  <lexeme><grapheme>Tura</grapheme><alias>Too-rah</alias></lexeme>

  <!-- #5 Göbekli Tepe -->
  <lexeme><grapheme>Göbekli Tepe</grapheme><alias>Guh-beck-lee Teh-peh</alias></lexeme>
  <lexeme><grapheme>Türkiye</grapheme><alias>Tur-kee-yeh</alias></lexeme>

  <!-- #4 Puma Punku -->
  <lexeme><grapheme>Puma Punku</grapheme><alias>Poo-mah Poon-koo</alias></lexeme>
  <lexeme><grapheme>Tiwanaku</grapheme><alias>Tee-wah-nah-koo</alias></lexeme>

  <!-- #3 Sacsayhuamán -->
  <lexeme><grapheme>Sacsayhuamán</grapheme><alias>Sak-sigh-wah-mahn</alias></lexeme>
  <lexeme><grapheme>Cusco</grapheme><alias>Koos-koh</alias></lexeme>

  <!-- #2 Derinkuyu -->
  <lexeme><grapheme>Derinkuyu</grapheme><alias>Deh-rin-koo-yoo</alias></lexeme>

  <!-- #1 Baalbek -->
  <lexeme><grapheme>Baalbek</grapheme><alias>Bahl-beck</alias></lexeme>
  <lexeme><grapheme>Beqaa</grapheme><alias>Beh-kah</alias></lexeme>
  <lexeme><grapheme>Trilithon</grapheme><alias>Try-lith-on</alias></lexeme>

  <!-- Channel name -->
  <lexeme><grapheme>Knowverse</grapheme><alias>Know-verse</alias></lexeme>
</lexicon>
